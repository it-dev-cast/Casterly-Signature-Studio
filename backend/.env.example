# Copy to .env and adjust. Never commit a real .env.
ENVIRONMENT=development

# REQUIRED. PostgreSQL only.
DATABASE_URL=postgresql+psycopg://signature_app:CHANGE_ME@localhost:5432/signature_studio
# Separate database for the test suite (name must end in _test; it is wiped on every test run).
TEST_DATABASE_URL=postgresql+psycopg://signature_app:CHANGE_ME@localhost:5432/signature_studio_test

# REQUIRED. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=7

# Absolute base URL used for images inside generated email signatures.
# Must be reachable by email recipients in production (e.g. https://signatures.example.com).
PUBLIC_BASE_URL=https://localhost:8443

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Outgoing email for "Send email" (signature setup emails). Leave SMTP_HOST empty to disable;
# the app then offers to open the email in your own mail app instead.
# Examples: Microsoft 365: smtp.office365.com:587 starttls | Gmail: smtp.gmail.com:587 starttls (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# nexusAuth employee sync (optional). Employees created or edited in nexusAuth are copied here
# automatically. Use a nexusAuth account with the operator or admin role. Leave NEXUSAUTH_URL empty to disable.
NEXUSAUTH_URL=
NEXUSAUTH_EMAIL=
NEXUSAUTH_PASSWORD=
NEXUSAUTH_SYNC_SECONDS=30
